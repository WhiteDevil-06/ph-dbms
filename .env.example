# ==============================================================================
# Post-Harvest DBMS Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN LOCAL DEVELOPMENT CREDENTIALS
# DO NOT COMMIT .env TO VERSION CONTROL
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# FastAPI Backend Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Data Provenance and Simulation Configuration
DATA_SOURCE_MODE=SIMULATION
SIMULATION_DEFAULT_SEED=42
ENABLE_SIMULATION_RESET=True

# Relational Database: MySQL 8.4 LTS
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=post_harvest_db
MYSQL_USER=post_harvest_app
MYSQL_PASSWORD=change_this_local_dev_password
MYSQL_ROOT_PASSWORD=change_this_local_root_password
# SQLAlchemy Connection URL placeholder
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=mysql+pymysql://post_harvest_app:change_this_local_dev_password@localhost:3306/post_harvest_db

# Document Database: MongoDB Community Server 8.0
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DATABASE=post_harvest_telemetry
MONGODB_USER=telemetry_app
MONGODB_PASSWORD=change_this_local_mongo_password
# PyMongo Connection URI placeholder
MONGODB_URI=mongodb://telemetry_app:change_this_local_mongo_password@localhost:27017/post_harvest_telemetry?authSource=admin

# Frontend Environment Variables (Vite requires VITE_ prefix)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_ENABLE_SIMULATION_BANNER=true

